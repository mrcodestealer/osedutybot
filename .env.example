# Ollama / LLM on server
# BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
# BOT_CHAT_MODEL=qwen3.6:35b-a3b          # chat, offsetai, dutyai, complex reasoning
# BOT_COMMANDAGENT_LLM_MODEL=qwen2.5:0.5b   # command routing only (commandagent)
# BOT_USE_COMMAND_MODEL_ONLY=1            # optional: force every agent to use command model

# ================= Newport activities watcher (newportwatch.py) =================
# Reads ONE group silently (never replies/reacts there), asks qwen3.6:35b-a3b whether
# a message is NEW stress-test or machine-pull-out information, and posts a card with
# the original text (+ images) to the target group, tagging the CC people.
# NEWPORT_WATCH=1                       # 0 disables the watcher
# NEWPORT_SOURCE_CHAT_ID=oc_1dd135e6e3dedab6fd356406d07e683b   # read-only group
# NEWPORT_TARGET_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432   # where notices go
# NEWPORT_CC_OPEN_IDS=ou_dadb58c6d52bd92f92fc3b74301137d7,ou_9927c4dfc0e063a22473a068f0579aed
# NEWPORT_MODEL=qwen3.6:35b-a3b
# NEWPORT_MIN_CONFIDENCE=0.6            # below this the message is ignored
# Only a genuine announcement is posted; questions, completion reports and
# amendments (retime / postponement / CANCELLATION) are not. Set to 1 to post
# amendments too — note a cancellation then arrives titled "New stress test information".
# NEWPORT_POST_AMENDMENTS=0

# ================= OSE roster leave marking (ose_Duty.py) =================
# 2026-07-27: the OSE shift roster NEVER shows AL/SL/HL/EL — those days show the
# person's D/N shift; that leave lives in the Bitable/HRMS only. Plain ``L`` is NOT
# swept and still shows on the roster. The periodic scan restores the shift (original
# from the snapshot, else the person's predominant shift that month; ties are reported,
# not guessed).
# Set to 1 to restore the old behaviour of marking leave on the roster.
# OSE_LEAVE_MARK_SHIFT_SHEET=0

# ================= /checkerror — AI journal-error review (checkerror.py) =================
# Reads ONLY error entries from the larkbot.service journal (journalctl) and has
# qwen3.6:35b-a3b report what error happened at what time. All optional:
# CHECKERROR_UNIT=larkbot.service    # journal unit (falls back to LARKBOT_SYSTEMD_UNIT)
# CHECKERROR_MODEL=qwen3.6:35b-a3b   # pinned reviewer model
# CHECKERROR_API_BASE=               # falls back to BOT_CHAT_API_BASE
# CHECKERROR_TIMEOUT=600             # LLM timeout (cold-loading 35B on CPU takes minutes)
# CHECKERROR_MAX_CHARS=9000          # max error-log chars sent to the model

# ================= OSM-Watch dashboard (osmwatch.py) =================
# osm-watch.cliveslot.com is Lark-OAuth gated. The bot keeps a warm browser and
# stores the session in osmwatch.json (gitignored) so it survives restarts.
# Commands: /osmwatch (screenshot to chat), /loginosmwatch (force a login QR).
# OSMWATCH_WARM=1                    # 0 disables the warm browser
# OSMWATCH_QR_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432   # group that receives login QRs
# OSMWATCH_KEEPALIVE_SEC=1800        # how often the warm browser re-checks the session
# OSMWATCH_LOGIN_TIMEOUT=240         # seconds to wait for someone to scan the QR
# OSMWATCH_TZ=Asia/Manila

# ================= Teams -> EVO maintenance auto-detect =================
# teamswatch.py holds a warm Microsoft Teams session (personal MSA, teams.live.com)
# for the EVO CS group and polls it; detectevomaintenance.py decides whether a new
# message is a maintenance notice and posts a card with [Generate Email] [Cancel].
# Generate Email runs exactly what typing /m does.
#
# One-time setup on the server, BEFORE enabling:
#   python teamswatch.py --login          # saves teamswatch_profile/ (gitignored)
#   python teamswatch.py --detect-now     # card the current newest, to prove it works
# Then set EVOTEAMS_ENABLED=1 and restart the bot. Check with /teamstatus.
#
# The FIRST poll after enabling adopts the group's newest message as a baseline and
# cards nothing, so switching this on never cards the existing backlog.
#
# EVOTEAMS_ENABLED=1                 # master switch; unset = watcher AND detector OFF
# EVOTEAMS_DRY_RUN=1                 # detect + log, post NOTHING (first-days safety)
# EVOTEAMS_POLL_SECONDS=60           # how often the warm page is re-read (min 15)
# EVOTEAMS_CARD_CHAT_ID=oc_51b6fbf2636525acfb4ead3afa3c93ce   # must be the /m group
# EVOTEAMS_GROUP=@EVO C88live/slot_ow.ph (RTS) CS Group NE RT FP
# EVOTEAMS_THREAD_ID=                # pin the Teams conversation id (see --dump-dom)
# EVOTEAMS_COMMAND_CHAT_IDS=         # groups allowed to run /latestevo
# EVOTEAMS_SOFT_CARDS=0              # 1 = also card notices /m cannot email
# EVOTEAMS_LLM=0                     # 1 = LLM-confirm soft matches (prod is CPU-only)
# EVOTEAMS_TZ=Asia/Manila
# TEAMS_SHOTS_KEEP=60                # screenshots kept in teamswatch_shots/
# TEAMS_HEADED=0                     # 1 = visible browser (local debug only)

# ========== Provider group check — /telegramgroupcheck (groupcheck.py) ==========
# Reads the maintenance Base, and for each row asks the platform named in its APP
# column (TELEGRAM / TEAMS) whether a chat with EXACTLY that Group Name exists.
# Each hit is carded with a screenshot of that chat's window; everything missing
# is listed by name. Read-only on both platforms.
#
# GROUPCHECK_SKIP — groups to leave alone entirely: never opened, never
# screenshotted, never reported as undetectable. Matched against the row's Group
# Name OR its Provider / Games value, by the same whole-string rule the lookup
# uses (trim, collapse whitespace, case-fold), so an entry here cannot silence a
# similarly-named group. Separate several with a NEWLINE or a SEMICOLON — not a
# comma, which is legal inside a chat title. Set it to an empty value to scan
# everything. Unset uses the default below.
#
# GROUPCHECK_SKIP=[CasinoPlus] CasinoPlus x BTi(SL) Support
# GROUPCHECK_APP_TOKEN=IjeqbdzCealXp1sDczClVL0sgOb
# GROUPCHECK_TABLE_ID=tbl0or9xQZGgnPz2
# GROUPCHECK_VIEW_ID=vewveZ9FDf     # fixes the row set AND the card order
# GROUPCHECK_TZ=Asia/Manila

# ===== Provider maintenance ask — /provideraskmaintenance (providerask.py) =====
# Sends "Hi team, are there any maintenance plans for this week?" into every
# pinned provider Telegram group, then collects replies for an hour, files them
# into the Base and posts a summary card.
#
# THIS IS THE ONLY COMMAND THAT WRITES INTO EXTERNAL PARTNER GROUPS.
#  * Every send is pinned to a peer id harvested by /telegramgroupcheck
#    (provider_peers.json). A group with no pin is reported, never messaged —
#    the send route runs allow_search=False so a same-titled stranger can never
#    be a target, and without a pin most groups would not resolve at all.
#  * Sends are paced 30-60s apart and the run STOPS on the first send that does
#    not confirm: a flood wait or slow mode would hit every later group too.
#  * One run at a time, journalled to providerask_state.json so a restart mid
#    window resumes instead of re-asking everybody.
#
# Run /telegramgroupcheck ONCE first to pin the peer ids.
#
# PROVIDERASK_TEXT=Hi team, are there any maintenance plans for this week?
# PROVIDERASK_GAP_MIN_SEC=30        # randomised gap between sends (flood safety)
# PROVIDERASK_GAP_MAX_SEC=60
# PROVIDERASK_WINDOW_MIN=60         # how long replies are collected
# PROVIDERASK_SWEEP_MIN=10          # how often the groups are re-read in that window
# PROVIDERASK_READ_COUNT=12         # messages read per group per sweep
# PROVIDERASK_CARD_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432  # default LABORATORY_GROUP
# PROVIDERASK_TZ=Asia/Manila
# PROVIDERASK_CLEAR_ENABLED=       # 1 = /provideraskmaintenance may blank an old window
#                                  # When a provider answers "no maintenance", a row
#                                  # that still holds a window which has ALREADY ENDED
#                                  # (last week's) gets Start/End emptied and Remark =
#                                  # "No maintenance". Emptying a DateTime means sending
#                                  # it null, the same risk VAWATCH_CLEAR_ENABLED guards.
#                                  # Unset/empty = follow VAWATCH_CLEAR_ENABLED (default
#                                  # 0), so one switch governs both paths, and by
#                                  # default such a row is listed under "needs a human"
#                                  # instead. A row with no window is written either way
#                                  # (Remark + Last Check only, no nulls). A window that
#                                  # has NOT ended yet is never blanked on this path,
#                                  # whatever this says: "no maintenance this week" must
#                                  # not erase next week's announced window.
# PROVIDERASK_WRITE_ATTEMPTS=3     # sweeps that may retry a failed Base write
#                                  # (1 = no retry, max 10). A failed write used to be
#                                  # recorded as "filled" and never retried, and the
#                                  # summary card went green. Now the row stays waiting
#                                  # and is retried on the next sweep (~10 min apart).
#                                  # After this many failures it is reported "could NOT
#                                  # be written" with one red card.
#
# The reply triage model. qwen3.6:35b-a3b is local Ollama on this box (an A3B
# MoE, ~3B active, which is why a 35B is viable on CPU). It decides only whether
# a message REPLIES to us; the maintenance window itself is parsed by regex
# (noticeparse) so a hallucinated time can never reach the sheet.
# PROVIDERASK_MODEL=qwen3.6:35b-a3b
# PROVIDERASK_TIMEOUT=600           # a COLD 35B load is 2-4 min; warm is ~5s
# PROVIDERASK_MIN_CONFIDENCE=0.6    # below this a reply is flagged for a human
# PROVIDERASK_MAX_MSG_CHARS=2500    # OLLAMA_CONTEXT_LENGTH is 8192
# PROVIDERASK_LLM_CONFIRM=1         # confirm-before-write: an answer's window is
#                                   # written only when the local model agrees the
#                                   # reply announces exactly that window as this
#                                   # provider's outage (see VAWATCH_LLM_CONFIRM).
#                                   # A "no" goes to a person; an unreachable model
#                                   # is retried (PROVIDERASK_WRITE_ATTEMPTS). 0
#                                   # writes on the parser alone.
#
# State: provider_peers.json (peer pins), providerask_state.json (the run).

# ========== VA maintenance watcher — /vacheck (vawatch.py) ==========
# Reads EVERY provider Telegram group the maintenance Base lists (APP =
# TELEGRAM), one group per VAWATCH_POLL_SEC tick, round-robin, so 18 groups are
# each re-read about every 18 minutes. When a provider posts a notice for an
# UPCOMING maintenance window, it fills that provider's row in the Base (Start
# Time, End Time, Remark = the whole message, Last Check = now; Reference is
# left alone) and posts a card to the Laboratory group. The name "VA watcher" is
# historical: it began with the VA announcements group only. VAWATCH_CHAT /
# VAWATCH_PROVIDER below are now the group a bare `/vacheck` reads and the
# fallback for a watcher that has never read the Base.
#
# IGNORED, with nothing written: "maintenance completed" notices and unrelated
# announcements such as an API parameter change. A completion notice quotes the
# SAME window as the original, so the completed/cancelled test runs first and
# wins outright. A notice whose window cannot be settled (see the NOTICE_*
# flags) is never guessed: it is carded to the Laboratory group as
# "❓ needs a human" and nothing is written.
#
# Nothing is ever sent in Telegram - the watcher only reads.
#
# The FIRST sweep of each group records its existing messages WITHOUT acting, so
# switching this on never re-announces an old notice or overwrites a row someone
# curated by hand. Prove the path any time with `/vacheck force`, or
# `/vacheck [force] <provider|alias|group name>` for one provider's group.
#
# Every setting in this file is read into the process ONCE, at startup: a change
# to .env needs a bot restart to take effect.
#
# VAWATCH_ENABLED=0                  # ON by default; set 0 (or false/off/no) to stop it
# VAWATCH_POLL_SEC=60                # how often the group is re-read (min 30)
# VAWATCH_CHAT=🆕VA 公告｜VA announcements   # must match the Base's Group Name
# VAWATCH_PROVIDER=VA                # the Provider / Games row that gets filled
# VAWATCH_CARD_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432   # default: LABORATORY_GROUP
# VAWATCH_READ_COUNT=8               # messages read per sweep (1-50)
# VAWATCH_TZ=Asia/Manila             # the watcher's CLOCK and DISPLAY zone only:
#                                    # log lines, ledger stamps, Last Check, and
#                                    # the zone a card shows a window in (keep it
#                                    # the zone the Base displays, so the card
#                                    # reads like the row). It is NOT the zone a
#                                    # notice is parsed in -
#                                    # that is NOTICE_TZ below. This line used to
#                                    # say it was, and setting it moved nothing.
#                                    # A name that cannot be loaded falls back to
#                                    # UTC+08:00 and is logged (and /vacheck shows it).
# VAWATCH_AUTH_RECHECK_SEC=900       # how often the Telegram auth page-reload is redone;
#                                    # a succeeding read already proves the session is alive,
#                                    # so this is NOT done every poll
# Ledger of handled notices: vawatch.json (delete it to re-baseline).
#
# --- how a notice is READ (noticeparse.py) ---
# These govern the parser that turns a provider's announcement into the Start
# Time / End Time the watcher writes. They apply to every provider on this path,
# not just VA. Every default below is the SAFE value and is what ships; each
# flag exists so a widening can be switched OFF from .env without a deploy,
# which in this repo is what "remove feature X" always means.
#
# Measured against testing/notice_corpus_test.py (621 cases on 2026-09-24):
# leaving EVERY NOTICE_* flag at its default is the only setting where every
# case passes. Each other value is listed with what it costs, as the number of
# corpus cases that then fail.
#
# A 1/0 flag set to anything else ("Y", "enabled", a typo) keeps its DEFAULT
# and is logged once; /vacheck repeats the warning. Garbage used to read as ON
# in noticeparse and as OFF in vawatch, so one .env line meant two things.
#
# NOTICE_TZ=Asia/Manila       # zone assumed when a notice states none. Kept
#                             # explicit so the parser never follows the host
#                             # clock; a zone the notice DOES state
#                             # (SGT/JST/ICT/EST/GMT+0530/北京时间) wins over it.
#                             # A zone the parser cannot pin down is NEVER
#                             # replaced by this one: an unknown name (CEST,
#                             # BST, "Malta time", 欧洲中部时间), IST (India,
#                             # Irish or Israel?) or an abbreviation not written
#                             # against a time goes to a person (needs_human).
#                             # PST and CST mean the reading whose offset equals
#                             # this zone's (Philippine / China +08 under
#                             # Asia/Manila; US Pacific under a US Pacific zone),
#                             # and go to a person when neither reading does.
#                             # A name that cannot be loaded (a typo such as
#                             # Asia/Kolkatta) falls back to UTC+08:00 and is
#                             # logged; /vacheck shows it.
# NOTICE_DATE_ORDER=dmy       # dmy | mdy. Only consulted when BOTH components
#                             # are <= 12: 23/09/2026 and 09/23/2026 are both
#                             # 23 September whatever this says. dmy because
#                             # every watched group is a Greater-China, SEA or
#                             # Malta studio and the operator reading the sheet
#                             # is in Manila - all day-first. The one mdy-native
#                             # provider (RTG) is an APP=TEAMS row nothing reads
#                             # today; wiring it in is this flag, not a deploy.
#                             # It governs a date WITH a year; the year-less
#                             # "10/12" is NOTICE_BARE_DATE_ORDER's, below.
#                             # mdy costs 3 cases: 05/09/2026 and 11/12/2026
#                             # flip month.
# NOTICE_BARE_DATE_ORDER=ask  # ask | mdy | dmy. How to read a year-less bare
#                             # "10/12" or "5/10" when both numbers could be the
#                             # month and no weekday such as "(一)" or "(Mon)"
#                             # settles it. NOTICE_DATE_ORDER (dmy) is the wrong
#                             # authority for this form: its one live sender,
#                             # KingMidas, writes it month-first ("9/23 (三)"),
#                             # so under dmy "将于11/4 (三)" was written as
#                             # 11 April 2027. With ask (the default and SAFE
#                             # value) such a notice is carded as needs_human
#                             # and nothing is written. Set mdy or dmy only if
#                             # every watched provider that uses the bare form
#                             # writes it that way; the flag is global, not per
#                             # provider. A bracketed weekday that fits exactly
#                             # one reading always wins, whatever this says.
#                             # mdy or dmy costs 1 case each.
# NOTICE_YEARLESS=1           # 1 = infer the year of a date that omits it
#                             # ("9/23", "9月23日", "Sep 23") as a pure function
#                             # of (text, now): the same (month, day) in
#                             # now.year-1/+0/+1, kept only inside
#                             # [now-120d, now+245d), earliest one on or after
#                             # today. Nothing in range = no window at all,
#                             # never a guessed year. A past date still parses
#                             # and is marked stale, which is what stops a
#                             # re-posted old notice overwriting a live row. A
#                             # year-less date more than 120 days AHEAD is more
#                             # likely an old notice re-posted than a new one:
#                             # it goes to a person unless its weekday confirms
#                             # the year.
#                             # 0 costs 46 cases, incl. the 9/23 shape inside
#                             # the live KingMidas message.
# NOTICE_WORDING=wide         # wide | strict. strict is the pre-2026-09 gate,
#                             # which rejected 27 of 28 real headings - 系统升级,
#                             # 停服公告, 維修, Server Maintenance, Scheduled
#                             # Downtime - every one carrying a readable window.
#                             # wide adds those by SUBJECT, not by keyword, so a
#                             # promo that is 活动暂停 or a banner page that
#                             # "will be unavailable" still writes nothing.
#                             # strict costs 66 cases: the whole E group, G2,
#                             # and 46 K cases. Set it if the widened gate is
#                             # ever suspected of writing a non-outage.
#
# The wording gate has three write-suppressing guards, each on by default. A
# message that ASKS about maintenance is not a notice (NOTICE_QUESTION_GUARD);
# a notice that says there will be NO downtime is not an outage, and a gate
# phrase that is negated does not count (NOTICE_NEGATION_GUARD); maintenance of
# a UAT/staging/测试环境 environment is not a production outage
# (NOTICE_NONPROD_GUARD). A notice one of them refuses is ignored (or, when it
# is a partial outage or names production too, sent to a person), and its reason
# says which guard spoke. NOTICE_WORDING=strict restores the pre-2026-09 gate in
# full: SCHED_RE over the whole message, without the plain-wording shapes
# ("Evolution maintenance <window>", "Maintenance Time:", 游戏维护, 将于…维护).
# strict together with all three guards at 0 reproduces the 67cf5f4 wording
# gate (corpus K-F75*); the date, zone and window rules stay as they are.
# Use strict if the widened gate is ever suspected of writing a non-outage; set a
# guard to 0 only if it is suspected of dropping real notices.
# NOTICE_QUESTION_GUARD=1     # refuse a message that ASKS about maintenance (a
#                             # sentence ending in ?/吗, containing 请问, or
#                             # opening "is there / do you / could you" that also
#                             # carries maintenance wording or a clock). It also
#                             # covers reschedule questions ("can the maintenance
#                             # be postponed to X?"). 0 turns it off.
#                             # 0 costs 10 cases.
# NOTICE_NEGATION_GUARD=1     # refuse a negated gate phrase ("will not cause
#                             # any service interruption", 无需停机维护) and veto
#                             # a notice that promises no downtime (no downtime,
#                             # 不停服, 不影响正常游戏). 0 turns both off.
#                             # 0 costs 12 cases.
# NOTICE_NONPROD_GUARD=1      # veto maintenance of a test environment (UAT /
#                             # staging / sandbox / 测试环境) when production is
#                             # not named or is said to be unaffected. 0 turns it
#                             # off. 0 costs 5 cases.
# NOTICE_DOUBT_GUARD=1        # the clean-notice check: a FILL is written only
#                             # when nothing else in the message could change
#                             # it. A notice that also withdraws, voids, pauses,
#                             # questions or requests the maintenance, promises
#                             # no impact, or names a date, second time, time of
#                             # day, next-day marker, zone or desk the window
#                             # does not account for, goes to a person instead
#                             # (needs_human, refused="doubt", the window named
#                             # in the reason, nothing written). A message that
#                             # names a maintenance and a window in wording no
#                             # rule trusts is also carded, not dropped. 0 turns
#                             # both off (the rules alone decide). 0 costs 159
#                             # cases - the verifier variants it exists for.
# NOTICE_REQUEST_GUARD=1      # A message that REQUESTS something of the provider
#                             # is the operator speaking, not the provider
#                             # announcing: "Please reschedule your maintenance
#                             # to 2026-09-25 03:00-05:00", 麻烦贵司将维护改到…,
#                             # "Kindly hold all releases on 09-24 02:00-04:00
#                             # due to our system maintenance", 请贵司在…我方维护
#                             # 期间暂停发版. With 1 the parser returns
#                             # needs_human (refused='request') and writes
#                             # nothing, and the row changes only when the
#                             # provider confirms. 0 restores the old behaviour,
#                             # where the request was written onto the
#                             # provider's row as its window, labelled
#                             # "(rescheduled)". 0 costs 8 cases.
# NOTICE_WINDOW_PICK=best     # best | first. first is the pre-2026-09 rule -
#                             # the first time range in the message wins - which
#                             # let a passing mention of LAST week's window
#                             # ("上周的维护窗口为 02:00 - 04:00") borrow this
#                             # week's date and invent an outage nobody
#                             # announced. best ranks the candidates instead
#                             # (not superseded > not a past mention > not
#                             # already over; a letterhead "Issued:" date is
#                             # never lent to a range), unions the pieces of
#                             # one outage (overlapping, touching, or at most a
#                             # 2h gap), and takes the earliest future one when
#                             # they are further apart - the rest are named in
#                             # the card, never written or merged.
#                             # first costs 7 cases.
# NOTICE_MAX_WINDOW_HOURS=48  # backstop for the maintenance parser. A notice
#                             # whose window runs longer than this many hours is
#                             # not written. This covers a single stated window,
#                             # or the union of touching pieces of one outage.
#                             # The verdict is needs_human and a person is
#                             # carded, because a span that long is far more
#                             # often a promotion, tournament or holiday period
#                             # than an outage: the ten-day "Mid-Autumn
#                             # promotion" and the seven-day Golden Week pause
#                             # were both written as outages before. 48 covers
#                             # an overnight migration across a weekend day.
#                             # Raise it for a provider that announces longer
#                             # migrations; 0 switches the cap off (costs 1
#                             # case). Anything that is not a number of hours
#                             # from 0 to 10000 keeps 48 and is logged.
# NOTICE_EXTENSION_FILL=1     # An "extended maintenance" notice ("The scheduled
#                             # maintenance on <window> is extended until
#                             # 14:00", 维护延长至14:00, "extended by 2 hours")
#                             # used to re-write the OLD end over the row, or
#                             # was dropped as stale or "not maintenance". With
#                             # 1 (default) the parser keeps the original start,
#                             # builds the new end on the original date (the
#                             # next day for an overnight window), and returns a
#                             # fill with reschedule=True. That happens only
#                             # when the original window is readable and the
#                             # extension lengthens it by at most 12h in the
#                             # same zone; otherwise the notice goes to a
#                             # person. 0 sends every extension to a person as
#                             # needs_human instead ("... becomes <window> - not
#                             # written"), with nothing written. 0 costs 4 cases.
#
# --- retries, the non-"fill" verdicts, and the watch list (vawatch.py) ---
# The ledger is what stops a notice being acted on twice, so anything it records
# as handled is never looked at again. These control the cases where that was
# wrong. Every default is the SAFE value; setting them as shown below is the
# behaviour you get with nothing set at all. A 1/0 flag set to anything else
# keeps its default and is logged once (/vacheck repeats it).
#
# VAWATCH_LLM_CONFIRM=1              # confirm-before-write. The regex parser
#                                    # proposes a window; the LOCAL model
#                                    # (providerllm, BOT_CHAT_API_BASE) must answer
#                                    # yes to all three of: the message ANNOUNCES
#                                    # it, it is THIS provider's outage, and it is
#                                    # EXACTLY this window in GMT+8. It never
#                                    # supplies a time. Anything short of that is a
#                                    # needs-human card and nothing is written. On
#                                    # 1390 adversarial test messages the parser
#                                    # alone wrote a wrong window ~1 in 5 times.
#                                    # 0 writes on the parser alone.
# VAWATCH_CONFIRM_ATTEMPTS=3         # sweeps a notice waits for an unreachable /
#                                    # cold model before it is carded instead
# VAWATCH_CONFIRM_TIMEOUT=60         # seconds per confirm call (a cold 35B load is
#                                    # 2-4 min; the load carries on server-side, so
#                                    # the next sweep is usually warm)
# VAWATCH_CONFIRM_MIN_CONFIDENCE=0.7 # below this the model's yes is not a yes
# VAWATCH_CONFIRM_ALLOW_REMOTE=0     # the confirm call goes only to a loopback /
#                                    # private / docker-name endpoint. With
#                                    # BOT_CHAT_API_BASE unset, chatagent falls back
#                                    # to api.openai.com - the check refuses it and
#                                    # cards the notice. 1 allows a remote model.
# VAWATCH_WRITE_ATTEMPTS=3           # tries per notice before it is given up on
#                                    # A failed Base write used to be ledgered
#                                    # exactly like a successful one, so one Lark
#                                    # 502 / expired token / rate-limit lost that
#                                    # provider's notice permanently. It is now
#                                    # retried on later sweeps (~18 min apart, one
#                                    # group per 60s tick over 18 groups), but
#                                    # BOUNDED: a row that can never be written -
#                                    # a Provider / Games value in no Base row -
#                                    # would otherwise card the Laboratory group
#                                    # every cycle for ever. 1 = the old, no-retry
#                                    # behaviour.
# VAWATCH_REPARSE_ATTEMPTS=3         # sweeps that may re-read an unreadable notice
#                                    # A bubble read while Telegram Web had not
#                                    # finished rendering it parses as "maintenance
#                                    # wording but no parseable date/time window";
#                                    # that used to burn the message id for good.
#                                    # Costs nothing to retry - no write, no card.
#                                    # A message that is simply not about
#                                    # maintenance is still marked once and dropped.
#                                    # 1 = the old behaviour. On the LAST try, a
#                                    # notice that states a clock but no date the
#                                    # parser can read ("Emergency maintenance
#                                    # 15:00-16:00 (GMT+8)") is carded once as
#                                    # "needs a human" instead of ending silently;
#                                    # nothing is written. An ack with no clock
#                                    # ("Thanks for the maintenance notice") is
#                                    # still dropped without a card.
# VAWATCH_CLEAR_ENABLED=0            # 1 = a "no maintenance" notice BLANKS the row
#                                    # noticeparse's `clear` verdict means the
#                                    # provider said nothing is planned; with this
#                                    # on, Start Time and End Time are emptied and
#                                    # Remark becomes "No maintenance" (Maintenance
#                                    # is a FORMULA and is never in the payload).
#                                    # OFF by default because clearing a bitable
#                                    # DateTime means sending it EMPTY, and if this
#                                    # tenant's field config rejects that the whole
#                                    # PUT is rejected - the row would not even get
#                                    # its Remark. With it off the notice is carded
#                                    # for a human instead of being dropped.
#                                    # Watch one clear land before leaving it on.
#                                    # Even with it on, a plain "no maintenance"
#                                    # never blanks a window that has not ENDED
#                                    # yet (read back from the row just before):
#                                    # "no maintenance this week" must not erase
#                                    # next week's announced window. That row is
#                                    # carded instead, as is a row that cannot be
#                                    # read back. With =1 it also blanks a row
#                                    # when a provider CANCELS exactly the window
#                                    # that row still holds, confirmed by reading
#                                    # the row back just before; Remark then
#                                    # becomes the cancellation text. A
#                                    # cancellation that names no window, a
#                                    # different window, or one in the shared
#                                    # Hacksaw/YGG group is carded instead, never
#                                    # cleared. The default 0 keeps every
#                                    # cancellation a card.
# VAWATCH_NEEDS_HUMAN_CARD=1         # 0 = do not card the verdicts a human must act on
#                                    # needs_human (rescheduled, new window
#                                    # unreadable - the row still shows the
#                                    # SUPERSEDED window), follow_quote (the answer
#                                    # is in the quoted message, which a bubble
#                                    # scraper cannot reach) and a `clear` that
#                                    # VAWATCH_CLEAR_ENABLED left unwritten. All
#                                    # three used to vanish into one "ignored".
#                                    # Turning this off restores that silence.
# VAWATCH_NEEDS_HUMAN_CAP=6          # max red "needs a human" cards ONE Base row
#                                    # may post per 24h; 0 = no cap. The two-way
#                                    # provider CS groups produce a lot of chat.
#                                    # Past this many red "❓ needs a human" cards
#                                    # for one row within 24 hours, ONE "⚠️ Card
#                                    # limit reached" card is posted and further
#                                    # ones are held back until the period ends.
#                                    # Held-back messages are recorded in the
#                                    # ledger and counted by /vacheck; nothing is
#                                    # ever written for them. In the shared
#                                    # Hacksaw/YGG group a message counts once.
# VAWATCH_IMAGE_CARD=1               # card a photo/document that may BE a
#                                    # maintenance notice (a poster); 0 = off.
#                                    # Some providers post the notice as a picture
#                                    # or file. A photo, video or document is
#                                    # carded ONCE ("🖼️ Maintenance notice may be
#                                    # an image") when its caption names
#                                    # maintenance, or when the provider's message
#                                    # right before or after it does without a
#                                    # readable window. Nothing is written: only a
#                                    # person can read the image. A captionless
#                                    # photo on its own, a poster beside a
#                                    # readable notice, and our own bubbles are
#                                    # never carded. Also off when
#                                    # VAWATCH_NEEDS_HUMAN_CARD=0.
# VAWATCH_TARGET_CACHE=1             # 0 = a Base-read failure collapses the watch list
#                                    # targets() used to fall back to the single
#                                    # VAWATCH_CHAT row on ANY read failure, so one
#                                    # transient 5xx shrank 18 groups to 1 and reset
#                                    # the rotation to the top, starving every
#                                    # provider past the first. The last good list
#                                    # is kept in vawatch.json and reused instead;
#                                    # the single-group fallback is only for a
#                                    # watcher that has never had a good read.
# VAWATCH_TARGET_CACHE_MAX_H=24      # hours on the cached watch list before ONE
#                                    # "watch list is stale" card; 0 = never.
#                                    # When the Base's provider list cannot be
#                                    # read (a deleted view, a wrong
#                                    # GROUPCHECK_VIEW_ID), the watcher keeps
#                                    # rotating over the last good list, and a
#                                    # provider row added since is not watched.
#                                    # After this many hours on the cached list,
#                                    # ONE orange card tells the Laboratory group.
#                                    # A good read re-arms it, and /vacheck names
#                                    # the stale list on every reply.
#
# --- whose maintenance is it? (attribution, vawatch.py) ---
# noticeparse finds a window; it cannot tell whose it is, and the group used to
# be the only proxy. Four ways that went wrong on the shared sheet: our own
# bubbles were written (VAWATCH_SKIP_OUTBOUND); the Hacksaw/YGG group wrote every
# notice onto BOTH rows (VAWATCH_SHARED_GROUP_CHECK: now a notice fills only the
# row it names, by name or VAWATCH_PROVIDER_ALIASES; one that names neither
# posts ONE "needs a human" card per message); and the operator's own notice
# ("Casinoplus will perform system maintenance", 我司…请暂停发版), a
# GCash/BDO/Globe/AWS relay, or another Base provider's notice relayed into a
# group overwrote that provider's real window (VAWATCH_OWNER_CHECK: now carded,
# never written). All three switches default to 1, the safe side, and 0
# restores the old behaviour. VAWATCH_OPERATOR_NAMES is the brand whose CS
# groups these are. VAWATCH_OPERATOR_SENDERS lists colleagues' Telegram display
# names (empty = unused); it is the only way to catch a colleague's bare
# "我司/our platform" notice, which reads word for word like a provider's.
# ALIASES format: Name=alias,alias;Other=alias (3 characters or fewer match
# case-sensitively, e.g. HS, YG, CP, IGO).
#
# VAWATCH_SKIP_OUTBOUND=1            # skip bubbles our own Telegram account sent
# VAWATCH_SHARED_GROUP_CHECK=1       # in a group two Base rows share (Hacksaw+YGG),
#                                    # write a row only when the notice names it.
#                                    # It ALSO governs /provideraskmaintenance's
#                                    # shared-chat routing: 0 there files an
#                                    # answer onto EVERY row that shares the chat,
#                                    # whatever it names (the answer naming only
#                                    # YGG lands on Hacksaw too) - leave it at 1
# VAWATCH_OWNER_CHECK=1              # card, never write, maintenance that is
#                                    # visibly the operator's, a payment / telco /
#                                    # cloud vendor's, or another Base provider's
# VAWATCH_PROVIDER_ALIASES=Hacksaw=HS,Hacksaw Gaming;YGG=Yggdrasil,YG;PP=Pragmatic Play,Pragmatic;KingMidas=KM,King Midas;SimplePlay=Simple Play;Yellow Bat=YellowBat;EEZE Slot=EEZE
#                                    # names each provider signs with (the value
#                                    # shown IS the code default). A non-empty
#                                    # value REPLACES the whole default, so copy
#                                    # every entry: dropping PP=... switches off
#                                    # "Dear Pragmatic team, our site..." being
#                                    # seen as written TO PP (R1.60), and that
#                                    # operator notice is then written onto PP
# VAWATCH_OTHER_STUDIOS=NetEnt,Relax Gaming,Evolution,Evolution Gaming,Microgaming,Play'n GO,Red Tiger,Nolimit City,Push Gaming,Thunderkick,Quickspin,BGaming,Habanero,Spadegaming,Playtech,Big Time Gaming,ELK Studios,Blueprint Gaming,Endorphina,Booongo,Wazdan,Betsoft,PAGCOR
#                                    # studios / brands that are NOT Base rows
#                                    # (R1.66): a notice naming one of them as
#                                    # its subject or signature is carded, never
#                                    # written. The value shown IS the code
#                                    # default; a non-empty value REPLACES the
#                                    # whole list (unset/empty = the default,
#                                    # the safe side)
# VAWATCH_OPERATOR_NAMES=CasinoPlus,Casino Plus,Casino-Plus,IGO,CP
#                                    # the operator brand; as the SUBJECT of a
#                                    # maintenance sentence it is the operator's
#                                    # window, not the provider's
# VAWATCH_OPERATOR_SENDERS=          # our colleagues' Telegram display names, |
#                                    # or , separated; their bubbles are carded,
#                                    # never written
#
# --- message ORDER within one group (vawatch.py) ---
# Telegram's data-mid only grows within a chat. With VAWATCH_ORDER_CHECK=1
# (default) an older message never overwrites the one that set the row, and is
# carded rather than written after a newer message was sent to a person. A
# bubble at or below the group's first read, or below a message the ledger has
# forgotten, is recorded as history. A second, later outage is carded and
# written only once the row's earlier window has ended, unless a newer message
# cancels it first - also when the row's window was set by hand or by
# /provideraskmaintenance (the row is read back), and also for a RESCHEDULE or
# extension of that second outage. A sooner outage that replaces a later one
# queues the later one to be written back once the sooner has ended. A deleted
# row notice and a read gap are carded. 0 turns all of that off: the LAST new message processed wins, whatever its data-mid - so
# an older notice that renders late, or an edit of an older one, DOES overwrite a
# newer reschedule. Leave it on. When a read does not reach back to the previous
# visit, the watcher re-reads VAWATCH_GAP_READ_COUNT bubbles (default 50). If
# even that leaves a gap, VAWATCH_GAP_CARD=1 posts one "possible missed
# messages" card per group per 6 hours (0 = log line only).
#
# A notice that states several SEPARATE windows (a phase 2 two days after
# phase 1) fills the earliest one still ahead; its card and /vacheck name the
# rest as "NOT written", to be entered by hand once the first has ended.
#
# VAWATCH_ORDER_CHECK=1              # data-mid order rules (older never overwrites
#                                    # newer, history below floor / evicted mark,
#                                    # deferral incl. hand-set rows, reschedules
#                                    # of the deferred outage and the write-back
#                                    # of a displaced later window, deleted / gap
#                                    # cards);
#                                    # 0 = newest-in-the-read wins
# VAWATCH_GAP_READ_COUNT=50          # bubbles to re-read when a read does not
#                                    # reach the previous visit (1-50, never below
#                                    # VAWATCH_READ_COUNT)
# VAWATCH_GAP_CARD=1                 # card the Laboratory group (at most once per
#                                    # group per 6h) when even the wider re-read
#                                    # leaves a gap; 0 = log only
#
# The rotation cursor is the (provider, group) PAIR - the ledger's own scope -
# with the list index kept only as a hint, so a list that changes length no
# longer teleports it, and the two rows sharing one group (Hacksaw and YGG) each
# get their turn. `python3 vawatch.py --targets` prints the watch
# list AND the Base rows nothing on this path reads (the APP=TEAMS providers and
# the GROUPCHECK_SKIP ones); the rotation logs the same list once per full cycle,
# and /vacheck carries it in its result. This watcher does not read Teams.
#
# The ledger key now includes the PROVIDER (two Base rows can name one group -
# Hacksaw and YGG do - and only the first was ever filled) and an edit marker
# (an edited notice keeps its data-mid, so corrections never landed). That
# invalidates every entry written before this change: vawatch.json is migrated
# automatically on first load, which costs ONE silent sweep per provider row.

# ================= IP / ISP lookup — /isp (ipisp.py) =================
# `/isp <ip> [ip ...]` answers with an "IP Details" card: ISP / Organization,
# Country and ASN, merged across six KEY-FREE public sources and across every IP
# in the command. Needs OUTBOUND HTTPS (plus plain HTTP for ip-api, whose free
# tier is http-only) to: ipinfo.io, ip-api.com, ipwho.is, api.ipapi.is,
# stat.ripe.net, api.iplocation.net. On an egress-restricted host every provider
# fails and the card reads "No public ISP data returned" — check egress first.
# BOT_ISP_TIMEOUT=7                  # seconds per provider request
# BOT_ISP_MAX_IPS=8                  # IPs checked per command (rest are skipped)
# BOT_ISP_WORKERS=12                 # parallel provider requests
# BOT_ISP_IPINFO_TOKEN=              # optional ipinfo.io token — richer org/ASN data
# BOT_ISP_CARD_CHIPS=1               # 0 = plain [IPinfo +2] chips on div/lark_md
#                                    #     instead of inline <text_tag> badges
#
# /isp is bound to one group, and in that group the bot is SILENT unless it is
# @mentioned AND the message is /isp — anything else gets no reply and no
# reaction at all (no other command, no duty routing, no AI chat). Card buttons,
# the bot footer menu, and scheduled posts INTO the group are unaffected.
# ISP_CHAT_IDS=oc_8c1c662b2e750a224a68bfc39d2d507f   # comma-separated; replaces the default
#
# Extra groups that may run /isp WITHOUT becoming isp-only — the group keeps
# every other command, duty routing and AI chat. Defaults to the Laboratory
# group (oc_ad9b5bdbb2826ba2ee9730920ef25432).
# ISP_EXTRA_CHAT_IDS=oc_ad9b5bdbb2826ba2ee9730920ef25432   # comma-separated; replaces the default
#
# Admins listed here may ALSO run /isp in a DM with the bot. Their DM is not
# restricted to /isp — every other command still works there.
# ISP_PM_ADMIN_OPEN_IDS=ou_5f660c0fb0769d184aca635d02209272   # comma-separated

# Offset auto-delete (2 calendar months). OFF — offsets kept indefinitely.
OSE_OFFSET_AUTO_PURGE=0

# OSE duty auto-display (07:00 morning + 19:00 evening cards to the duty group).
# OFF — the cards no longer post on a schedule. /ose and /osedate still work.
OSE_DUTY_AUTO_ENABLED=0

# MY OSE weekly meeting reminder (Tuesday 17:00 @-ping to the duty group). OFF.
OSE_WEEKLY_MEETING_ENABLED=0

# ================= Daily health report (health_report.py + health_checks.py) =================
# Once a day the bot posts a health card (Lark API, scheduler, Ollama, mail, scrape,
# browser watchers, threads, memory/disk, 24h journal errors) to the Laboratory group.
# All optional; defaults shown. Preview without sending: python health_report.py --preview
# Unset: sends only from the systemd service (a PC or shell run stays quiet). 1: from anywhere. 0: never.
# HEALTH_REPORT_ENABLE=
# HEALTH_REPORT_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432 # target group
# HEALTH_REPORT_TIME=09:00                                  # HH:MM, comma-separated for several a day
# HEALTH_REPORT_TZ=UTC+8                                    # or an IANA name, e.g. Asia/Kuala_Lumpur
# HEALTH_REPORT_ON_START=0                                  # 1 also posts one ~2 min after each boot
