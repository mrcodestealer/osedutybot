# Copy to server as .env and fill in real values:
#   cp .env.example .env
# Real .env is NOT in git (secrets). Sync .env to server separately (scp/rsync).

BOT_USE_AI=1
BOT_USE_CHITCHAT=0
BOT_USE_CHATAGENT=1
BOT_CHATAGENT_BACKEND=llm
BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
BOT_CHAT_API_KEY=ollama
BOT_CHAT_MODEL=qwen3.6:35b-a3b
BOT_COMMANDAGENT_LLM_MODEL=qwen2.5:0.5b
# BOT_OFFSET_LLM_MODEL=qwen2.5:0.5b   # all offset LLM: offsetleave classify + offsetai agent
BOT_COMMANDAGENT_LLM_TIMEOUT=8
BOT_CHAT_VISION_MODEL=qwen3.5:9b
BOT_CHAT_LLM_MAX_TOKENS=256
BOT_CHAT_LLM_MAX_REPLY_CHARS=2000
BOT_CHAT_LLM_TIMEOUT=300
BOT_CHAT_LLM_THINK=false
BOT_CHAT_OLLAMA_KEEP_ALIVE=-1

# Code-aware chat (RAG over osedutybot source — see codeassist.py)
BOT_CODE_ASSIST=1
BOT_CODE_ROOT=/root/osedutybot
BOT_CODE_RAG=1
BOT_CODE_EMBED_MODEL=nomic-embed-text
# BOT_CODE_RAG_ALWAYS=1
# BOT_CODE_TOP_K=8

# Maintenance email (must stay on server in .env — never commit .env)
# MAINTENANCE_MAIL_USER=om@hotelstotsenberg.com
# MAINTENANCE_MAIL_PASSWORD=
# MAINTENANCE_MAIL_IMAP_HOST=imap.larksuite.com
# MAINTENANCE_MAIL_IMAP_PORT=993
# MAINTENANCE_MAIL_IMAP_SSL=1
# MAINTENANCE_MAIL_TARGET_CHAT_ID=
# After the EVO maintenance watcher replies (CP forward or NOT IN CP internal reply),
# move the original mail from its folder (e.g. OSE Pending) back to INBOX. Default on.
# MAINT_MOVE_TO_INBOX=1
# maintenance.json = runtime IMAP state (local only, in .gitignore)
# Extra groups allowed to run /egsreplytest (test reply → junchen@ only; /egsreply and
# /egs stay pinned to the /m command group). Comma-separated; EXTENDS the built-in
# default (oc_ad9b5bdbb2826ba2ee9730920ef25432).
# EGSREPLY_TEST_EXTRA_CHAT_IDS=
# /egsreply + /egsreplytest nest the WHOLE conversation into the reply (like a manual
# Reply All) so Lark Mail's Show/Hide unfolds every earlier message. Set 0 to go back to
# quoting only the original /egs send. Needs the allemail index (ALLEMAIL_CACHE=1), which
# is also what bounds how far back the thread can be rebuilt (ALLEMAIL_WINDOW_DAYS).
# EGS_REPLY_QUOTE_THREAD=1
# Max messages nested into one reply (each level carries a full body).
# EGS_REPLY_QUOTE_MAX_MESSAGES=15
# /sports is /egs with different recipients (same group gate, same LLM title, same
# QA/CS "Kindly check this email" ping, its own sports.json / sportstest.json stores).
# Comma-separated "Name <addr>" list; unset uses the defaults shown here. An EMPTY
# SPORTS_MAIL_CC (SPORTS_MAIL_CC=) sends /sports with no Cc at all.
# SPORTS_MAIL_TO=CS (Team) <cs@igo.email>, Toby <toby@igo.ph>
# SPORTS_MAIL_CC=CP OM Duty <om@hotelstotsenberg.com>, Allan Guo <allan.guo001@igo.ph>
# /sportstest + /sportsreplytest target; unset falls back to the /egs test address.
# SPORTS_TEST_REPLY_TO=junchen@snsoft.my
# SPORTS_TEST_REPLY_CC=om@hotelstotsenberg.com
# Signature on /sports mail; unset reuses EGS_MAIL_SIGNATURE. Literal \n allowed.
# SPORTS_MAIL_SIGNATURE=

