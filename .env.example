# Copy to server as .env and fill in real values:
#   cp .env.example .env
# Real .env is NOT in git (secrets). Sync .env to server separately (scp/rsync).

BOT_USE_AI=1
BOT_USE_CHITCHAT=0
BOT_USE_CHATAGENT=1
BOT_CHATAGENT_BACKEND=llm
BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
BOT_CHAT_API_KEY=ollama
BOT_CHAT_MODEL=qwen3.6:35b-a3b
BOT_COMMANDAGENT_LLM_MODEL=qwen2.5:0.5b
# BOT_OFFSET_LLM_MODEL=qwen2.5:0.5b   # all offset LLM: offsetleave classify + offsetai agent
BOT_COMMANDAGENT_LLM_TIMEOUT=8
BOT_CHAT_VISION_MODEL=qwen3.5:9b
BOT_CHAT_LLM_MAX_TOKENS=256
BOT_CHAT_LLM_MAX_REPLY_CHARS=2000
BOT_CHAT_LLM_TIMEOUT=300
BOT_CHAT_LLM_THINK=false
BOT_CHAT_OLLAMA_KEEP_ALIVE=-1

# Code-aware chat (RAG over osedutybot source — see codeassist.py)
BOT_CODE_ASSIST=1
BOT_CODE_ROOT=/root/osedutybot
BOT_CODE_RAG=1
BOT_CODE_EMBED_MODEL=nomic-embed-text
# BOT_CODE_RAG_ALWAYS=1
# BOT_CODE_TOP_K=8

# Maintenance email (must stay on server in .env — never commit .env)
# MAINTENANCE_MAIL_USER=om@hotelstotsenberg.com
# MAINTENANCE_MAIL_PASSWORD=
# MAINTENANCE_MAIL_IMAP_HOST=imap.larksuite.com
# MAINTENANCE_MAIL_IMAP_PORT=993
# MAINTENANCE_MAIL_IMAP_SSL=1
# MAINTENANCE_MAIL_TARGET_CHAT_ID=
# After the EVO maintenance watcher replies (CP forward or NOT IN CP internal reply),
# move the original mail from its folder (e.g. OSE Pending) back to INBOX. Default on.
# MAINT_MOVE_TO_INBOX=1
# maintenance.json = runtime IMAP state (local only, in .gitignore)

PORT=5000

BOT_PLAYWRIGHT_HEADLESS=1
# Jenkins warm browsers — keep logged in 24/7 (Duty Bot server; avoids ~20s cold Chromium + login)
PROD_WARM_POOL=0
JU_WARM_POOL=1
# One logged-in Chromium per Jenkins job URL (auto from registry; override on dev with JU_WARM_URLS)
# JU_WARM_URLS=https://jenkins.client8.me/job/FPMS/job/FPMS_UAT_BRANCH_UPDATE/build?delay=0sec
JU_WARM_KEEPALIVE_SEC=240
JU_WARM_RETRY_ATTEMPTS=3
# Default 0 = never fall back to cold browser + login (retry warm pool instead)
JU_WARM_ALLOW_COLD_FALLBACK=0
VPN_WARM_BROWSER=1
VPN_WARM_ALLOW_COLD_FALLBACK=0
# Log Third Http warm browsers (checkcredit / stuck credit / checkmachinelog screenshots)
THIRD_HTTP_WARM_POOL=1
THIRD_HTTP_WARM_ENVS=NP,NCH,DHS,CP,TBP,WF
# Playwright screenshot scratch PNGs (if /tmp missing on server, use repo .tmp)
# TMPDIR=/root/osedutybot/.tmp
# Block bot listen until warm browsers are logged in (seconds; 0 = fire-and-forget prewarm only)
JENKINS_WARM_STARTUP_WAIT_SEC=120
# Duty bot → jenkinsbot HTTP (find old VPN .conf files)
# JENKINS_BOT_HOST=127.0.0.1
# JENKINS_BOT_PORT=5000
# JENKINS_INTERNAL_TOKEN=same-as-jenkinsbot-DUTY_INTERNAL_TOKEN

# Lark app (required)
APP_ID=
APP_SECRET=
VERIFICATION_TOKEN=
# http = public Request URL (default); websocket = persistent connection (no public URL)
# LARK_EVENT_MODE=websocket
BOT_OPEN_ID=
DUTY_CHAT_ID=

# Spreadsheet tokens — see your existing server .env for full list
OSE_SPREADSHEET_TOKEN=
OSE_SHEET_ID=

# Ollama / LLM on server
# BOT_CHAT_API_BASE=http://127.0.0.1:11434/v1
# BOT_CHAT_MODEL=qwen3.6:35b-a3b          # chat, offsetai, dutyai, complex reasoning
# BOT_COMMANDAGENT_LLM_MODEL=qwen2.5:0.5b   # command routing only (commandagent)
# BOT_USE_COMMAND_MODEL_ONLY=1            # optional: force every agent to use command model

# ================= OSE roster leave marking (ose_Duty.py) =================
# 2026-07-27: the OSE shift roster NEVER shows AL/SL/HL/EL — those days show the
# person's D/N shift; that leave lives in the Bitable/HRMS only. Plain ``L`` is NOT
# swept and still shows on the roster. The periodic scan restores the shift (original
# from the snapshot, else the person's predominant shift that month; ties are reported,
# not guessed).
# Set to 1 to restore the old behaviour of marking leave on the roster.
# OSE_LEAVE_MARK_SHIFT_SHEET=0

# ================= /checkerror — AI journal-error review (checkerror.py) =================
# Reads ONLY error entries from the larkbot.service journal (journalctl) and has
# qwen3.6:35b-a3b report what error happened at what time. All optional:
# CHECKERROR_UNIT=larkbot.service    # journal unit (falls back to LARKBOT_SYSTEMD_UNIT)
# CHECKERROR_MODEL=qwen3.6:35b-a3b   # pinned reviewer model
# CHECKERROR_API_BASE=               # falls back to BOT_CHAT_API_BASE
# CHECKERROR_TIMEOUT=600             # LLM timeout (cold-loading 35B on CPU takes minutes)
# CHECKERROR_MAX_CHARS=9000          # max error-log chars sent to the model

# ================= OSM-Watch dashboard (osmwatch.py) =================
# osm-watch.cliveslot.com is Lark-OAuth gated. The bot keeps a warm browser and
# stores the session in osmwatch.json (gitignored) so it survives restarts.
# Commands: /osmwatch (screenshot to chat), /loginosmwatch (force a login QR).
# OSMWATCH_WARM=1                    # 0 disables the warm browser
# OSMWATCH_QR_CHAT_ID=oc_ad9b5bdbb2826ba2ee9730920ef25432   # group that receives login QRs
# OSMWATCH_KEEPALIVE_SEC=1800        # how often the warm browser re-checks the session
# OSMWATCH_LOGIN_TIMEOUT=240         # seconds to wait for someone to scan the QR
# OSMWATCH_TZ=Asia/Manila
