[Unit]
Description=OSE Duty Bot (Flask + Lark persistent WebSocket)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/osedutybot
EnvironmentFile=/root/osedutybot/.env
Environment=LARK_EVENT_MODE=websocket
Environment=PORT=5000
Environment=JU_WARM_POOL=1
Environment=JU_WARM_ALLOW_COLD_FALLBACK=0
ExecStart=/root/miniconda3/envs/fpmsbot/bin/python /root/osedutybot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
