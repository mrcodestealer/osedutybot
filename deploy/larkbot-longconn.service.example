[Unit]
Description=OSE Duty Bot (Flask + Lark persistent WebSocket)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/osedutybot
EnvironmentFile=/root/osedutybot/.env
Environment=LARK_EVENT_MODE=websocket
Environment=PORT=5000
ExecStart=/root/miniconda3/bin/python main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
